<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Resource\fonts\" />
      <Folder Include="Resource\img\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resource\img\mtHollyBackground.png" />
      <Resource Include="Resource\img\mtHollyBackground.png" />
      <None Remove="Resource\fonts\Dosis-Medium.ttf" />
      <Resource Include="Resource\fonts\Dosis-Medium.ttf" />
      <None Remove="Resource\fonts\Dosis-SemiBold.ttf" />
      <Resource Include="Resource\fonts\Dosis-SemiBold.ttf" />
      <None Remove="Resource\fonts\Dosis-Regular.ttf" />
      <Resource Include="Resource\fonts\Dosis-Regular.ttf" />
      <None Remove="Resource\fonts\Dosis-Light.ttf" />
      <Resource Include="Resource\fonts\Dosis-Light.ttf" />
      <None Remove="Resource\fonts\Dosis-Bold.ttf" />
      <Resource Include="Resource\fonts\Dosis-Bold.ttf" />
      <None Remove="Resource\fonts\Dosis-ExtraBold.ttf" />
      <Resource Include="Resource\fonts\Dosis-ExtraBold.ttf" />
      <None Remove="Resource\fonts\Dosis-ExtraLight.ttf" />
      <Resource Include="Resource\fonts\Dosis-ExtraLight.ttf" />
    </ItemGroup>

</Project>
