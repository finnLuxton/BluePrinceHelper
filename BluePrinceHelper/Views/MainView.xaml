<Window x:Class="BluePrinceHelper.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Blue Prince Helper"
        Width="684"
        Height="393"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Background>
        <ImageBrush ImageSource="/Resource/img/mtHollyBackground.png"></ImageBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!-- Toolbar --> 
        <Grid Background="Navy"
              Grid.ColumnSpan="3"
              MouseDown="Toolbar_MouseDown">
            <Grid.ColumnDefinitions>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
                 <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Blue Prince Helper"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       FontFamily="/Resource/fonts/#Dosis Medium.ttf"
                       />
            
            <TextBlock Text="Coring (WIP)"
                       Grid.Column="2"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Resource/fonts/#Dosis Medium.ttf"
            />
            
            <TextBlock Text="Darts (TBD)"
                       Grid.Column="3"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Resource/fonts/#Dosis Medium.ttf"
            />
            
            <Button Click="CloseWindow"
                    Grid.Column="8"
                    Grid.ColumnSpan="2"
                    ClickMode="Press"
                    Content="Exit"
                    Foreground="White"
                    FontSize="10"
                    FontWeight="Medium"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="MediumPurple"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value ="Purple"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="75" Height="15"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                                        
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
        </Grid>
        
        <!-- Centre Menu -->
        <StackPanel Grid.Row = "2" Grid.ColumnSpan="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="15, -55, 15, 15">
            <StackPanel>
                <!-- <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="500"> -->
                <!--     <TextBlock Text="Blue Prince Helper" -->
                <!--                FontSize="20" -->
                <!--                FontWeight="Medium" -->
                <!--                Foreground="White" -->
                <!--                VerticalAlignment="Top" -->
                <!--                HorizontalAlignment="Center" -->
                <!--                FontFamily="/Resource/fonts/#Dosis Medium.ttf"/> -->
                <!-- </StackPanel> -->
                
                <TextBlock Text="Numeric Coring"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="/Resource/fonts/#Dosis Medium.ttf"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Right Menu Input Boxes -->
        <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center">
            <TextBox Name="InputCoreValue"
                     PreviewTextInput="NumberValidationTextBox"
                     MinWidth="100" MinHeight="20" MaxWidth="100" MaxHeight="20"
                     Margin="0,5,0,10"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"/>
            
                <Button Click="OnClickGetCore"
                        ClickMode="Press"
                        IsDefault="True"
                        Content="Get Numeric Core"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Medium"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="CadetBlue"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value ="DarkCyan"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="150" Height="25"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}">
                                        
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            
            <TextBox Name="OutputCoreValue"
                     PreviewTextInput="NumberValidationTextBox"
                     IsHitTestVisible="False"
                     MinWidth="100" MinHeight="20" MaxWidth="100" MaxHeight="20"
                     Margin="0,40,0,5"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
